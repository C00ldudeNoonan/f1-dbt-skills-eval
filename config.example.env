# Snowflake connection (SSO via externalbrowser, reused from ~/.dbt/profiles.yml)
SF_ACCOUNT=CHANGE_ME
SF_USER=CHANGE_ME
SF_ROLE=TRANSFORMER
SF_WAREHOUSE=TRANSFORMING
SF_DATABASE=ANALYTICS_DEV

# Schemas
# Full dataset, used only by the injector to "arrive" held-out races. Agents never get this name.
SF_HOLDOUT_SCHEMA=ZZ_F1EVAL_HOLDOUT
# Starting raw state (last HOLDOUT_RACES races of the latest season stripped of results)
SF_PRISTINE_SCHEMA=ZZ_F1EVAL_PRISTINE
HOLDOUT_RACES=2

# Models
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
CLAUDE_MAX_BUDGET_USD=40
WIZARD_MODEL=dbt/glm-5.3
# Set after: wizard providers set-key anthropic && wizard providers set-model ... (see README)
WIZARD_CLAUDE_MODEL=anthropic/claude-opus-5-5

# Pinned dbt-agent-skills commit for arm B
SKILLS_DIR=vendor/dbt-agent-skills/skills/dbt

# Agent workspaces live OUTSIDE this repo so agents can't stumble onto answer keys
RUNS_DIR=$HOME/f1-eval-workspaces

# Secret salt for vendor-B ids and planted conflicts (keeps answer mappings out of Snowflake)
EVAL_SALT=CHANGE_ME
